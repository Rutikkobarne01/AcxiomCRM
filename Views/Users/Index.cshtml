@model AcxiomCRM.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">User & Role Administration</h2>
        <p class="text-muted mb-0">Manage system users, assigned security roles, and account access policies</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus-fill me-1"></i> Add New User
            </a>
        </div>
    }
</div>

<!-- Search & Filter -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="search" class="form-control" placeholder="Search by name, email, username..." value="@Model.SearchTerm" />
            </div>
            <div class="col-md-3">
                <select name="role" class="form-select">
                    <option value="">All Security Roles</option>
                    <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
                    <option value="Manager" selected="@(Model.RoleFilter == "Manager")">Manager</option>
                    <option value="SalesExecutive" selected="@(Model.RoleFilter == "SalesExecutive")">Sales Executive</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
            </div>
            <div class="col-md-1">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>User Name</th>
                        <th>Email / Login</th>
                        <th>Security Role</th>
                        <th>Status</th>
                        <th>Lockout Status</th>
                        <th>Registered Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td>
                                <strong>@u.FullName</strong>
                            </td>
                            <td>
                                <div>@u.Email</div>
                                <small class="text-muted">Username: @u.UserName</small>
                            </td>
                            <td>
                                @if (u.Role == "Admin")
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else if (u.Role == "Manager")
                                {
                                    <span class="badge bg-info text-dark">Manager</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Sales Executive</span>
                                }
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i> Locked Out</span>
                                    <div class="small text-danger">Until @u.LockoutEnd?.ToString("HH:mm") UTC</div>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-unlock-fill me-1"></i> Normal</span>
                                    @if (u.AccessFailedCount > 0)
                                    {
                                        <div class="small text-muted">@u.AccessFailedCount failed attempts</div>
                                    }
                                }
                            </td>
                            <td>
                                <small class="text-muted">@u.CreatedDate.ToString("dd MMM yyyy")</small>
                            </td>
                            <td class="text-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Edit User & Roles">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>

                                        @if (u.IsLockedOut)
                                        {
                                            <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="Unlock Account">
                                                    <i class="bi bi-unlock"></i> Unlock
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(u.IsActive ? "btn-outline-secondary" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted">View Only</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
