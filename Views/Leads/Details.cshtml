@model AcxiomCRM.Models.Entities.Lead
@{
    ViewData["Title"] = Model.LeadName + " - Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">@Model.LeadName</h2>
            <span class="badge bg-light text-dark border font-monospace">@Model.LeadCode</span>
            @if (Model.Status == "Converted")
            {
                <span class="badge bg-success"><i class="bi bi-check-all me-1"></i> Converted</span>
            }
            else
            {
                <span class="badge bg-primary">@Model.Status</span>
            }
        </div>
        <p class="text-muted mb-0">@(Model.CompanyName ?? "Prospect Account") &bull; Captured on @Model.CreatedDate.ToString("dd MMM yyyy")</p>
    </div>

    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer & Deal
            </a>
        }
        else if (Model.ConvertedCustomerId.HasValue)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId.Value" class="btn btn-outline-success btn-sm">
                <i class="bi bi-person-check me-1"></i> View Converted Customer
            </a>
        }

        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-primary btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Lead Details -->
    <div class="col-md-5">
        <div class="card shadow-sm h-100">
            <div class="card-header"><i class="bi bi-person-badge me-2 text-primary"></i> Lead Profile</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Email</dt>
                    <dd class="col-sm-7"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></dd>

                    <dt class="col-sm-5 text-muted small">Phone</dt>
                    <dd class="col-sm-7"><a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a></dd>

                    <dt class="col-sm-5 text-muted small">Source</dt>
                    <dd class="col-sm-7"><span class="badge bg-light text-dark border">@Model.Source</span></dd>

                    <dt class="col-sm-5 text-muted small">Priority</dt>
                    <dd class="col-sm-7">
                        <span class="badge @(Model.Priority == "High" ? "bg-danger" : Model.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">
                            @Model.Priority
                        </span>
                    </dd>

                    <dt class="col-sm-5 text-muted small">Expected Value</dt>
                    <dd class="col-sm-7 fw-bold text-success fs-5">₹@Model.ExpectedValue.ToString("N0")</dd>

                    <dt class="col-sm-5 text-muted small">Assigned Salesperson</dt>
                    <dd class="col-sm-7"><span class="badge bg-light text-dark border">@(Model.AssignedUser?.FullName ?? "Assigned")</span></dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Related Follow-Ups & Activities -->
    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-header"><i class="bi bi-clock-history me-2 text-warning"></i> Lead Engagement Timeline</div>
            <div class="card-body">
                @{
                    var followUps = ViewBag.FollowUps as List<AcxiomCRM.Models.Entities.FollowUp> ?? new();
                    var activities = ViewBag.Activities as List<AcxiomCRM.Models.Entities.Activity> ?? new();
                }

                @if (followUps.Any() || activities.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var f in followUps)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-0">
                                <div>
                                    <span class="badge @(f.Status == "Planned" ? "bg-warning text-dark" : "bg-success") me-2">@f.Status</span>
                                    <strong>@f.Subject</strong>
                                    <div class="small text-muted">Follow-Up scheduled for @f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                                </div>
                            </li>
                        }

                        @foreach (var a in activities)
                        {
                            <li class="list-group-item py-2 px-0">
                                <div>
                                    <span class="badge bg-info text-dark me-2">@a.ActivityType</span>
                                    <strong>@a.Subject</strong>
                                    <div class="small text-muted">@a.ActivityDate.ToString("dd MMM yyyy, hh:mm tt") &bull; @a.Description</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-chat-left-dots fs-3 d-block mb-1"></i>
                        No interactions logged yet for this lead.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
