@model AcxiomCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "CRM Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Sales & CRM Dashboard</h2>
        <p class="text-muted mb-0">
            Welcome back, <strong>@Model.UserName</strong> &bull;
            Role Scope: <span class="badge bg-primary">@Model.UserRole</span>
        </p>
    </div>

    <!-- Date Range Filter -->
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted small fw-semibold">Filter Range:</span>
        <div class="btn-group" role="group">
            <a asp-action="Index" asp-route-dateRange="All" class="btn btn-sm @(Model.DateRangeFilter == "All" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
            <a asp-action="Index" asp-route-dateRange="Today" class="btn btn-sm @(Model.DateRangeFilter == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
            <a asp-action="Index" asp-route-dateRange="Week" class="btn btn-sm @(Model.DateRangeFilter == "Week" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
            <a asp-action="Index" asp-route-dateRange="Month" class="btn btn-sm @(Model.DateRangeFilter == "Month" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
        </div>
        <a asp-controller="Opportunities" asp-action="Create" class="btn btn-sm btn-success ms-2">
            <i class="bi bi-plus-lg"></i> New Deal
        </a>
    </div>
</div>

<!-- 1. KPI Cards Row (PDF Section 17.11) -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card shadow-sm h-100" style="border-left-color: #3b82f6;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="kpi-label">Total Customers</div>
                        <div class="kpi-value text-primary">@Model.TotalCustomers</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small">
                    <a asp-controller="Customers" asp-action="Index" class="text-decoration-none">View directory &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Leads & Open Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card shadow-sm h-100" style="border-left-color: #f59e0b;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="kpi-label">Leads (Total / Open)</div>
                        <div class="kpi-value text-warning">@Model.TotalLeads <span class="fs-5 text-muted fw-normal">(@Model.OpenLeads open)</span></div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="bi bi-funnel fs-3"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small">
                    <a asp-controller="Leads" asp-action="Index" class="text-decoration-none">Manage pipeline &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Opportunities: Won / Open / Lost -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card shadow-sm h-100" style="border-left-color: #10b981;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="kpi-label">Deals (Won / Total)</div>
                        <div class="kpi-value text-success">@Model.WonOpportunities <span class="fs-5 text-muted fw-normal">/ @Model.TotalOpportunities</span></div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="bi bi-trophy fs-3"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small">
                    <span class="text-success fw-semibold">@Model.OpenOpportunities Open Deals</span> &bull; <span class="text-danger">@Model.LostOpportunities Lost</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Sales Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card shadow-sm h-100" style="border-left-color: #8b5cf6;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="kpi-label">Sales Pipeline Value</div>
                        <div class="kpi-value text-purple" style="color: #7c3aed;">₹@Model.TotalPipelineValue.ToString("N0")</div>
                    </div>
                    <div class="rounded-circle bg-purple bg-opacity-10 p-3" style="color: #7c3aed; background-color: #f3e8ff;">
                        <i class="bi bi-currency-rupee fs-3"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small">
                    Weighted Pipeline: <strong class="text-dark">₹@Model.WeightedPipelineValue.ToString("N0")</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. Chart.js Visualizations (PDF Section 17.12) -->
<div class="row g-3 mb-4">
    <!-- Lead Status Chart -->
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-pie-chart me-2 text-primary"></i> Lead Status Distribution</span>
                <span class="badge bg-light text-dark border">Chart.js</span>
            </div>
            <div class="card-body d-flex flex-column justify-content-center">
                <div style="position: relative; height: 260px;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Opportunity Pipeline by Stage Chart -->
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bar-chart-steps me-2 text-primary"></i> Opportunity Pipeline by Stage</span>
                <span class="badge bg-light text-dark border">Values (₹)</span>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 260px;">
                    <canvas id="pipelineStageChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Sales Chart -->
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-graph-up-arrow me-2 text-success"></i> Monthly Sales Trends</span>
                <span class="badge bg-light text-dark border">Past 6 Months</span>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 260px;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3. Overdue & Upcoming Follow-ups + Recent Activity Timeline -->
<div class="row g-3">
    <!-- Upcoming & Overdue Follow-ups -->
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-alarm me-2 text-warning"></i> Actionable Follow-Ups & Tasks</span>
                <a asp-controller="FollowUps" asp-action="Create" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-plus-circle"></i> Schedule Follow-Up
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.OverdueFollowUps.Any())
                {
                    <div class="p-2 bg-danger bg-opacity-10 text-danger border-bottom fw-semibold small px-3">
                        <i class="bi bi-exclamation-octagon-fill me-1"></i> Overdue Tasks (@Model.OverdueFollowUps.Count)
                    </div>
                    <ul class="list-group list-group-flush mb-2">
                        @foreach (var f in Model.OverdueFollowUps)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                <div>
                                    <span class="badge bg-danger me-2">Overdue</span>
                                    <strong>@f.Subject</strong>
                                    <div class="small text-muted">
                                        <i class="bi bi-calendar-event me-1"></i> @f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")
                                        &bull; @(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "General")
                                    </div>
                                </div>
                                <form asp-controller="FollowUps" asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Done">
                                        <i class="bi bi-check2"></i> Complete
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }

                <div class="p-2 bg-light text-muted border-bottom fw-semibold small px-3">
                    <i class="bi bi-clock-history me-1"></i> Upcoming Tasks (@Model.UpcomingFollowUps.Count)
                </div>
                @if (Model.UpcomingFollowUps.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var f in Model.UpcomingFollowUps)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                <div>
                                    <span class="badge bg-info text-dark me-2">@f.FollowUpType</span>
                                    <strong>@f.Subject</strong>
                                    <div class="small text-muted">
                                        <i class="bi bi-clock me-1"></i> @f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")
                                        &bull; @(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "General")
                                    </div>
                                </div>
                                <form asp-controller="FollowUps" asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Done">
                                        <i class="bi bi-check2"></i>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">
                        <i class="bi bi-check-circle fs-3 text-success d-block mb-1"></i>
                        No pending follow-ups scheduled!
                    </div>
                }
            </div>
            <div class="card-footer bg-white text-center">
                <a asp-controller="FollowUps" asp-action="Index" class="text-decoration-none small">View all scheduled follow-ups &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Recent Activities Timeline -->
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <i class="bi bi-activity me-2 text-primary"></i> Recent Sales Activities
            </div>
            <div class="card-body p-3">
                @if (Model.RecentActivities.Any())
                {
                    <div class="timeline">
                        @foreach (var a in Model.RecentActivities)
                        {
                            <div class="d-flex mb-3 pb-2 border-bottom">
                                <div class="me-3">
                                    <span class="badge rounded-circle p-2 @(a.ActivityType == "Call" ? "bg-primary" : a.ActivityType == "Meeting" ? "bg-warning text-dark" : "bg-info text-dark")">
                                        <i class="bi @(a.ActivityType == "Call" ? "bi-telephone" : a.ActivityType == "Meeting" ? "bi-calendar-event" : "bi-envelope")"></i>
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@a.Subject</div>
                                    <div class="text-muted" style="font-size: 0.8rem;">
                                        @(a.Customer?.CustomerName ?? a.Lead?.LeadName ?? "Sales Activity") &bull; @a.ActivityDate.ToString("dd MMM, hh:mm tt")
                                    </div>
                                    @if (!string.IsNullOrEmpty(a.Description))
                                    {
                                        <div class="text-secondary small mt-1">@a.Description</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No activities logged yet.</div>
                }
            </div>
            <div class="card-footer bg-white text-center">
                <a asp-controller="Activities" asp-action="Index" class="text-decoration-none small">View activity history &rarr;</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Lead Status Doughnut Chart
        const leadCtx = document.getElementById('leadStatusChart').getContext('2d');
        new Chart(leadCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                    backgroundColor: ['#3b82f6', '#06b6d4', '#10b981', '#8b5cf6', '#ef4444'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                }
            }
        });

        // 2. Pipeline By Stage Bar Chart
        const pipelineCtx = document.getElementById('pipelineStageChart').getContext('2d');
        new Chart(pipelineCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels)),
                datasets: [{
                    label: 'Pipeline Value (₹)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageAmounts)),
                    backgroundColor: ['#0ea5e9', '#f59e0b', '#8b5cf6', '#10b981', '#ef4444'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(val) { return '₹' + Number(val).toLocaleString(); }
                        }
                    }
                }
            }
        });

        // 3. Monthly Sales Chart
        const salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels)),
                datasets: [{
                    label: 'Won Deals Revenue (₹)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesValues)),
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.3,
                    borderWidth: 3,
                    pointBackgroundColor: '#10b981',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12 } }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(val) { return '₹' + Number(val).toLocaleString(); }
                        }
                    }
                }
            }
        });
    </script>
}
