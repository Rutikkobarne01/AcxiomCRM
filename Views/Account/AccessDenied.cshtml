@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-danger p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x display-1"></i>
            </div>
            <h2 class="fw-bold text-danger">403 - Access Denied</h2>
            <p class="text-muted mt-2">
                You do not have the required role or authorization to access this page or perform this action.
            </p>
            <div class="mt-4 d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house-door me-1"></i> Go to Dashboard
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-box-arrow-right me-1"></i> Switch Account
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
