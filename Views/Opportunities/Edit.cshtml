@model AcxiomCRM.ViewModels.OpportunityCreateEditViewModel
@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-0">Edit Opportunity: @Model.OpportunityName</h3>
                <span class="text-muted small">Update sales stage and deal probability</span>
            </div>
            <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label fw-semibold"></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomersList">
                                <option value="">-- Direct Prospect / Unlinked --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Amount" class="form-control" id="oppAmount" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label fw-semibold"></label>
                            <select asp-for="Stage" class="form-select" id="stageSelect">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" id="oppProbability" min="0" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small fw-semibold text-uppercase">Derived Weighted Value:</span>
                                    <div class="small text-muted">Amount &times; Probability / 100</div>
                                </div>
                                <div class="fs-4 fw-bold text-primary" id="weightedDisplay">₹0</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                                <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList">
                                </select>
                            </div>
                        }

                        <div class="col-12 mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                <i class="bi bi-check2-circle me-1"></i> Update Opportunity
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateWeighted() {
            const amt = parseFloat(document.getElementById('oppAmount').value) || 0;
            const prob = parseFloat(document.getElementById('oppProbability').value) || 0;
            const weighted = (amt * prob) / 100;
            document.getElementById('weightedDisplay').innerText = '₹' + Math.round(weighted).toLocaleString();
        }

        document.getElementById('oppAmount').addEventListener('input', updateWeighted);
        document.getElementById('oppProbability').addEventListener('input', updateWeighted);

        document.getElementById('stageSelect').addEventListener('change', function() {
            const probInput = document.getElementById('oppProbability');
            if (this.value === 'Qualification') probInput.value = 25;
            else if (this.value === 'Proposal') probInput.value = 50;
            else if (this.value === 'Negotiation') probInput.value = 75;
            else if (this.value === 'Won') probInput.value = 100;
            else if (this.value === 'Lost') probInput.value = 0;
            updateWeighted();
        });

        updateWeighted();
    </script>
}
